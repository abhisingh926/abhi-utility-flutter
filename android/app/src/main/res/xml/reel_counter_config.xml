<?xml version="1.0" encoding="utf-8"?>
<!-- Scroll and screen-change events. No package filter: the service needs to know
     when a social app is left, but for other apps it only reads the package name.
     Content changes are only looked at in Settings / the package installer
     (uninstall protection); every other app's are ignored straight away. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewScrolled|typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="150"
    android:description="@string/reel_counter_description" />
