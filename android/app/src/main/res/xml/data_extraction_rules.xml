<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: nothing of Abhi Utility goes to Google Drive backup or to a new
  phone by device transfer. The diary, App Lock settings and login tokens stay
  on this phone; the app's own (encrypted) cloud backup is the way to move them.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
